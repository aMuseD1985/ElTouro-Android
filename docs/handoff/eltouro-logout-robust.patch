From 43b3d9fc0096e47cffa2d3dfa386275d06a528d6 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 21:28:37 +0000
Subject: [PATCH] Logout and password reset never fail because of the app
 device keys

On a server where the migration for app_devices has not run, every logout
ended in "Da ist etwas schiefgelaufen" (Base table app_devices doesn't
exist). revokeAppDevicesSafely() logs the failure and lets the logout/reset go
on.
---
 app_device_lib.php | 13 +++++++++++++
 logout.php         |  2 +-
 password_reset.php |  2 +-
 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/app_device_lib.php b/app_device_lib.php
index 5e53b03..77bb483 100644
--- a/app_device_lib.php
+++ b/app_device_lib.php
@@ -70,3 +70,16 @@ function revokeAppDevices(int $userId): void
 {
     dbExec('UPDATE app_devices SET revoked_at = UTC_TIMESTAMP() WHERE user_id = ? AND revoked_at IS NULL', [$userId]);
 }
+
+/**
+ * For logout and password reset: revoke the app keys, but never let that break signing out – e.g. on a server where the
+ * migration for app_devices has not run yet. The failure goes to the error log only.
+ */
+function revokeAppDevicesSafely(int $userId): void
+{
+    try {
+        revokeAppDevices($userId);
+    } catch (Throwable $e) {
+        error_log('ElTouro: app keys not revoked for user ' . $userId . ' – ' . $e->getMessage());
+    }
+}
diff --git a/logout.php b/logout.php
index 75fe1ca..ee0ec37 100644
--- a/logout.php
+++ b/logout.php
@@ -9,7 +9,7 @@ if (isPost()) {
         require_once __DIR__ . '/account_lib.php';
         revokeAppRemember((int)$_SESSION['uid']);
         require_once __DIR__ . '/app_device_lib.php';
-        revokeAppDevices((int)$_SESSION['uid']);
+        revokeAppDevicesSafely((int)$_SESSION['uid']);   // signing out must never fail because of the app keys
     }
     $_SESSION = [];
     session_regenerate_id(true);
diff --git a/password_reset.php b/password_reset.php
index 5a3bdc2..4e54778 100644
--- a/password_reset.php
+++ b/password_reset.php
@@ -24,7 +24,7 @@ if (isPost()) {
         dbExec('UPDATE users SET password_hash = ? WHERE id = ?', [password_hash($pw, PASSWORD_DEFAULT), $uid]);
         require_once __DIR__ . '/app_device_lib.php';
         revokeAppRemember($uid);   // a new password signs every app out
-        revokeAppDevices($uid);
+        revokeAppDevicesSafely($uid);
         logIn($uid);
         flash(t('password.new_ok'));
         redirect('/');
-- 
