diff --git a/app_device.php b/app_device.php
new file mode 100644
index 0000000..509fb18
--- /dev/null
+++ b/app_device.php
@@ -0,0 +1,58 @@
+<?php
+/**
+ * POST /api/app/device (JSON) – the Android app's device key (app_device_lib.php).
+ *   {"action": "register", "version": "0.3.0 (57)"}   signed-in session + X-CSRF  -> {"token": "eld_…"}
+ *   {"action": "revoke"}                               with the device key          -> {"ok": true}
+ *   {"action": "check"}                                with the device key          -> {"ok": true}   (401 when unknown/revoked)
+ */
+declare(strict_types=1);
+require_once __DIR__ . '/app_device_lib.php';
+$withKey = appDeviceTokenFromRequest() !== '';
+if ($withKey) {
+    define('SKIP_ACCESS_GATE', true);   // the key is the credential, not the tester password (like api.php)
+    define('NO_SESSION', true);
+}
+require __DIR__ . '/bootstrap.php';
+header('Content-Type: application/json; charset=utf-8');
+header('Cache-Control: no-store');
+
+function deviceRespond(int $code, array $data): never
+{
+    http_response_code($code);
+    echo json_encode($data, JSON_UNESCAPED_SLASHES);
+    exit;
+}
+
+if (!isPost()) {
+    deviceRespond(405, ['error' => 'method']);
+}
+$input = json_decode((string)file_get_contents('php://input'), true);
+$action = is_array($input) ? (string)($input['action'] ?? '') : '';
+
+if ($withKey) {
+    $auth = appDeviceAuthenticate();
+    if ($action === 'revoke') {
+        appDeviceRevoke(appDeviceTokenFromRequest());
+        deviceRespond(200, ['ok' => true]);
+    }
+    if ($auth['user'] === null) {
+        deviceRespond($auth['error'] === 'consent' ? 403 : 401, ['error' => $auth['error']]);
+    }
+    if ($action === 'check') {
+        deviceRespond(200, ['ok' => true]);
+    }
+    deviceRespond(400, ['error' => 'action']);
+}
+
+$me = currentUser();
+if ($me === null) {
+    deviceRespond(401, ['error' => 'login']);
+}
+if (!checkCsrfHeader()) {
+    deviceRespond(400, ['error' => 'csrf']);
+}
+session_write_close();
+if ($action !== 'register') {
+    deviceRespond(400, ['error' => 'action']);
+}
+deviceRespond(200, ['token' => appDeviceCreate((int)$me['id'], (string)($input['version'] ?? ''))]);
diff --git a/app_device_lib.php b/app_device_lib.php
new file mode 100644
index 0000000..5e53b03
--- /dev/null
+++ b/app_device_lib.php
@@ -0,0 +1,72 @@
+<?php
+/**
+ * Android app: one key per installed app ("device key", eld_ + 40 hex), stored only as SHA-256.
+ * The app's background parts (recording upload, later push and widgets) authenticate with it when the WebView's
+ * session is gone – e.g. after Android killed the app during a ride with the display off.
+ * Sent as "Authorization: Bearer eld_…" and, because some CGI setups drop that header, also as "X-Device-Token".
+ * A key is created from a signed-in WebView (POST /api/app/device, session + X-CSRF) and revoked on logout,
+ * on a password reset and with the account (FK ON DELETE CASCADE).
+ */
+declare(strict_types=1);
+
+const APP_DEVICES_PER_USER = 5;          // older keys of the same rider are deleted
+const APP_DEVICE_SEEN_EVERY = 300;       // last_seen_at is written at most every 5 minutes
+
+/** The device key of this request, or '' – usable before bootstrap.php (decides SKIP_ACCESS_GATE). */
+function appDeviceTokenFromRequest(): string
+{
+    foreach (['HTTP_AUTHORIZATION', 'REDIRECT_HTTP_AUTHORIZATION', 'HTTP_X_DEVICE_TOKEN'] as $k) {
+        $v = trim((string)($_SERVER[$k] ?? ''));
+        if (preg_match('/^(?:Bearer\s+)?(eld_[0-9a-f]{40})$/i', $v, $m)) {
+            return strtolower($m[1]);
+        }
+    }
+    return '';
+}
+
+function appDeviceCreate(int $userId, string $appVersion): string
+{
+    $plain = 'eld_' . bin2hex(random_bytes(20));
+    dbExec('INSERT INTO app_devices (user_id, token_hash, prefix, app_version, last_seen_at) VALUES (?, ?, ?, ?, UTC_TIMESTAMP())',
+        [$userId, hash('sha256', $plain), substr($plain, 0, 8), mb_substr(trim($appVersion), 0, 40) ?: null]);
+    dbExec('DELETE FROM app_devices WHERE user_id = ? AND id NOT IN (
+              SELECT id FROM (SELECT id FROM app_devices WHERE user_id = ? AND revoked_at IS NULL ORDER BY id DESC LIMIT ' . APP_DEVICES_PER_USER . ') t)',
+        [$userId, $userId]);
+    return $plain;
+}
+
+/**
+ * The rider behind the device key of this request → ['user' => row, 'error' => null], or ['user' => null, 'error' => 'device'|'consent'].
+ * Same checks as a signed-in session: active, confirmed, current consent.
+ */
+function appDeviceAuthenticate(): array
+{
+    $plain = appDeviceTokenFromRequest();
+    if ($plain === '') {
+        return ['user' => null, 'error' => 'device'];
+    }
+    $dev = dbOne('SELECT id, user_id, last_seen_at FROM app_devices WHERE token_hash = ? AND revoked_at IS NULL', [hash('sha256', $plain)]);
+    $user = $dev ? dbOne("SELECT id, email, display_name, locale, is_admin, consent_version FROM users
+                          WHERE id = ? AND status = 'active' AND email_verified_at IS NOT NULL", [$dev['user_id']]) : null;
+    if ($dev === null || $user === null) {
+        return ['user' => null, 'error' => 'device'];
+    }
+    if ((int)$user['consent_version'] < CONSENT_VERSION) {
+        return ['user' => null, 'error' => 'consent'];
+    }
+    $seen = $dev['last_seen_at'] !== null ? (int)strtotime($dev['last_seen_at'] . ' UTC') : 0;
+    if (time() - $seen > APP_DEVICE_SEEN_EVERY) {
+        dbExec('UPDATE app_devices SET last_seen_at = UTC_TIMESTAMP() WHERE id = ?', [$dev['id']]);
+    }
+    return ['user' => $user, 'error' => null];
+}
+
+function appDeviceRevoke(string $plain): void
+{
+    dbExec('UPDATE app_devices SET revoked_at = UTC_TIMESTAMP() WHERE token_hash = ? AND revoked_at IS NULL', [hash('sha256', $plain)]);
+}
+
+function revokeAppDevices(int $userId): void
+{
+    dbExec('UPDATE app_devices SET revoked_at = UTC_TIMESTAMP() WHERE user_id = ? AND revoked_at IS NULL', [$userId]);
+}
diff --git a/docs/app-interface.md b/docs/app-interface.md
new file mode 100644
index 0000000..dd4dac0
--- /dev/null
+++ b/docs/app-interface.md
@@ -0,0 +1,57 @@
+# Schnittstelle App ↔ Web-App
+
+Gilt für beide Repos: `aMuseD1985/ElTouro-Android` (diese App) und `aMuseD1985/ElTouro` (Web-App, Server). Eine Kopie liegt
+im Web-Repo; wer hier etwas ändert, ändert beide. **Grundregel: nur ergänzen, nie umbenennen oder entfernen.** Die APK lädt
+die Web-App vom Server – alte APKs treffen auf neue Seiten und neue APKs auf alte Seiten. Neues wird per Feature-Erkennung
+benutzt (Methode vorhanden? `status().version`?), nie vorausgesetzt.
+
+## 1. Brücke Seite → App (Capacitor-Plugin `EltouroTracker`)
+
+JS-Seite: `assets/native_tracker.js` im Web-Repo (`window.ElTouroNative`). Native Seite: `TrackerPlugin.kt` hier.
+
+| Methode | Argumente | Seit | Zweck |
+|---|---|---|---|
+| `start` | `{baseUrl, csrf, session?, title, text}` | 0.1 | Berechtigungen, Fahrt-Dienst starten; `session` > 0 = Aufzeichnung |
+| `setSession` | `{session, csrf}` | 0.1 | Aufzeichnung ein (Session des Servers) |
+| `clearSession` | – | 0.1 | Aufzeichnung aus, Rest hochladen |
+| `stop` | – | 0.1 | Rest hochladen, Dienst beenden, Fahrt nicht mehr aktiv |
+| `batterySettings` | – | 0.1 | Akku-Optimierung (seit 0.2 direkter Systemdialog) |
+| `openExternal` | `{url}` (nur `https://`) | 0.1 | Custom Tab, z. B. Google-Anmeldung |
+| `getRemember` / `setRemember` / `clearRemember` | `{token}` (64 hex) | 0.1 | „Angemeldet bleiben“; `clearRemember` widerruft seit 0.3 auch den Geräteschlüssel |
+| `log` | `{msg}` | 0.2 | Zeile ins Diagnose-Log (max. 60/min, 300 Zeichen) |
+| `status` | – → `{preciseLocation, backgroundLocation, notifications, batteryUnrestricted, complete, serviceRunning, version}` | 0.2 | was für Fahrten mit Display aus fehlt (`version` = 2) |
+| `diagnostics` | – | 0.2 | Bildschirm „Diagnose“ öffnen |
+
+Ereignis `location`: `{lat, lng, acc, heading?, speedMs?, t}` (jede Position, solange die Seite lebt).
+
+## 2. Endpunkte, die die App direkt ruft
+
+| Endpunkt | Auth | Inhalt |
+|---|---|---|
+| `POST /api/track` | Geräteschlüssel (`Authorization: Bearer eld_…` **und** `X-Device-Token`) oder Session-Cookie + `X-CSRF` | `{"action":"points","session_id":n,"points":[[unixMs,lat,lng,acc,kmh\|null],…]}` → `{"stored":n}`; höchstens 600 Punkte (`TRACK_MAX_BATCH`) |
+| `POST /api/app/device` | Session + `X-CSRF` | `{"action":"register","version":"…"}` → `{"token":"eld_…"}` |
+| `POST /api/app/device` | Geräteschlüssel | `{"action":"check"}` → `{"ok":true}`; `{"action":"revoke"}` |
+| `POST /api/app/remember` | Session + `X-CSRF` | → `{"token": 64 hex}` (holt die Seite, speichert die App) |
+| `GET /auth/app?t=…&next=…` / `?r=…` | Einmal-Token / Remember-Token | meldet die WebView an |
+| `GET /auth/app-return` | – | Ende der Google-Anmeldung im Browser → `de.eltouro.app://login?t=…&next=…` |
+
+Antworten, auf die sich die App verlässt (`Uploader`): 2xx = angekommen; `404`/`409` = Session unbekannt/nicht mehr offen →
+Punkte verwerfen; `401` = Schlüssel/Sitzung weg (mit Schlüssel: Rückfall auf Cookie, neuer Schlüssel); `400` CSRF, `403`
+Einwilligung (`{"error":"consent"}`), `302` Zugangsschutz, 5xx → behalten, später erneut. **Weiterleitungen sind für die App
+Fehler** – eine API-Antwort darf nie eine Seite sein. `{"stored":0}` bei Punkten = Aufzeichnung serverseitig schon beendet
+(nach 2 h ohne Position, `finishStaleRecordings()`).
+
+Anfragen mit Geräteschlüssel laufen ohne Tester-Cookie und ohne Session (`SKIP_ACCESS_GATE`, `NO_SESSION`), die Einwilligung
+prüft `appDeviceAuthenticate()`.
+
+## 3. Links und Hosts
+
+App Links / Intent-Filter: `https://app.eltouro.de`, `test.eltouro.de`, `beta.eltouro.de` (andere Hosts öffnet die App nicht).
+Eigenes Schema: `de.eltouro.app://login?t=<64 hex>&next=<Pfad>`. Google-Knopf in der App: die Seite hängt `?app=1` an und öffnet
+ihn über `openExternal`.
+
+## 4. Datenschutz
+
+Jede Änderung, was die App speichert oder überträgt, braucht die Datenschutzerklärung im Web-Repo (`legal_texts.php`, Abschnitt
+„Android-App“, DE+EN, Marker in `legalMarkers()`, Hash des alten Standardtexts in `$earlierDefaults`, ggf. `CONSENT_VERSION`,
+Export/Löschung in `account_data_lib.php`).
diff --git a/legal_texts.php b/legal_texts.php
index a728108..ada311e 100644
--- a/legal_texts.php
+++ b/legal_texts.php
@@ -143,6 +143,8 @@ Eine Tour besteht aus den Wegpunkten, die du auf der Karte setzt, und der daraus
 
 **Fahrmodus:** Im Fahrmodus nutzt die Navigation deinen Standort, um dir Abbiegehinweise anzusagen. Das passiert nur in deinem Browser; ohne Aufzeichnung wird dein Standort nicht an uns übertragen. Schaltest du „Fahrt aufzeichnen“ ein, schickt die App während der Fahrt etwa alle zwei Sekunden deine Position samt Genauigkeit und Geschwindigkeit an unseren Server. Wir speichern die Aufzeichnung, berechnen daraus Strecke, Fahrzeit und Höchstgeschwindigkeit und vermerken die gefahrenen Kilometer für Punkte und Ränge. Die Aufzeichnung sieht nur du; du kannst sie auf der Tourseite jederzeit löschen, dann sind alle Positionen endgültig entfernt. Rechtsgrundlage ist der Nutzungsvertrag (Art. 6 Abs. 1 lit. b DSGVO); die Aufzeichnung ist freiwillig.
 
+**Android-App:** Nutzt du ElTouro als Android-App, meldet sich die App einmal mit deinem Konto bei uns an und bekommt dafür einen eigenen Geräteschlüssel. Wir speichern davon nur einen Hashwert und die ersten Zeichen (damit du mehrere Geräte unterscheiden kannst), dazu die App-Version und wann der Schlüssel angelegt und zuletzt benutzt wurde. Mit dem Schlüssel schickt die App eine laufende Aufzeichnung auch dann an uns, wenn sie im Hintergrund oder bei ausgeschaltetem Display läuft. Bis die Positionen bei uns angekommen sind (etwa bei Funkloch), hält die App sie auf deinem Gerät vor und löscht sie danach. Die Berechtigung „Standort immer zulassen“ nutzt die App nur, um eine laufende Fahrt fortzusetzen, wenn Android sie unterbrochen hat. Für die Fehlersuche führt die App ein Diagnose-Protokoll nur auf deinem Gerät (Zustand des Fahrt-Dienstes, Berechtigungen, Akku-Einstellungen – keine Positionen); es verlässt dein Gerät nur, wenn du es selbst teilst. Meldest du dich ab oder setzt dein Passwort neu, wird der Schlüssel ungültig; mit deinem Konto wird er gelöscht. Rechtsgrundlage ist der Nutzungsvertrag (Art. 6 Abs. 1 lit. b DSGVO).
+
 **Sprüche und Landschaft:** Damit Touro im Fahrmodus etwas zur Landschaft sagen kann („Felder, so weit das Auge reicht“), fragt unser Server beim Overpass-Dienst (siehe „Pausen-Vorschläge“) nach Acker-, Wald- und Wasserflächen und Parks entlang deiner Strecke und rechnet Anstiege und lange Geraden aus der Strecke selbst. Übermittelt werden nur Kartenausschnitte, nicht deine IP-Adresse und nicht dein Konto; das Ergebnis speichern wir pro Tour. Welche Sprüche du schon gehört hast, merkt sich die App nur auf deinem Gerät (damit sich nichts zu schnell wiederholt). Du kannst die Sprüche im Fahrmodus abschalten. Rechtsgrundlage ist der Nutzungsvertrag (Art. 6 Abs. 1 lit. b DSGVO).
 
 **Sprachansagen:** Touros Ansagen und Geschichten sind vorab aufgenommene Sprachclips. Sie sind mit einer künstlichen Stimme erzeugt (KI-Sprachsynthese eines externen Anbieters, aus festen Texten; Nutzerdaten gelangen dorthin nicht) und liegen auf unseren Servern. Wo für einen Satz kein Clip existiert, nutzt dein Gerät seine eigene Sprachausgabe; das geschieht auf dem Gerät.
@@ -279,6 +281,8 @@ A route consists of the waypoints you set on the map and the calculated track. W
 
 **Ride mode:** In ride mode the navigation uses your location to announce turns. This happens only in your browser; without recording your location is not sent to us. If you switch on “Record ride”, the app sends your position with accuracy and speed to our server about every two seconds while you ride. We store the recording, calculate distance, riding time and top speed, and note the kilometres for points and ranks. Only you can see the recording; you can delete it on the route page at any time, which removes all positions for good. Legal basis: the user agreement (Art. 6(1)(b) GDPR); recording is voluntary.
 
+**Android app:** If you use ElTouro as an Android app, the app signs in with your account once and gets a device key of its own. We store only a hash of it and its first characters (so you can tell several devices apart), plus the app version and when the key was created and last used. With the key the app sends a running recording to us even while it runs in the background or with the display off. Until the positions have reached us (for example in a dead zone), the app keeps them on your device and deletes them afterwards. The app uses the permission “Allow location all the time” only to continue a running ride after Android interrupted it. For troubleshooting the app keeps a diagnostics log on your device only (state of the ride service, permissions, battery settings – no positions); it leaves your device only if you share it yourself. When you log out or reset your password, the key becomes invalid; it is deleted with your account. Legal basis: the user agreement (Art. 6(1)(b) GDPR).
+
 **Banter and scenery:** So that Touro can comment on the scenery in ride mode (“fields as far as the eye can see”), our server asks the Overpass service (see “Stop suggestions”) for farmland, forest, water and parks along your route and works out climbs and long straights from the route itself. Only map sections are transmitted, not your IP address and not your account; we store the result per route. Which remarks you have already heard is remembered only on your device (so nothing repeats too soon). You can switch the remarks off in ride mode. Legal basis: the user agreement (Art. 6(1)(b) GDPR).
 
 **Voice announcements:** Touro's announcements and stories are pre-recorded voice clips. They are produced with an artificial voice (AI speech synthesis by an external provider, from fixed texts; no user data reaches it) and stored on our servers. Where no clip exists for a sentence, your device uses its own speech output; that happens on the device.
