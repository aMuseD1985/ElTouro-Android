+/**
+ * The page is shown inside the ElTouro Android app (aMuseD1985/ElTouro-Android). The app appends "ElTouroApp/<version>" to its
+ * user agent; older APKs without it are caught in the browser by assets/app-pref.js (class "is-app" from Capacitor).
+ * Used to leave out what only makes sense in a browser – "keep the display on", the footer for signed-in riders.
+ */
+function isApp(): bool
+{
+    return str_contains((string)($_SERVER['HTTP_USER_AGENT'] ?? ''), 'ElTouroApp/');
+}
