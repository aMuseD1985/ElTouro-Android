From f3bcf00a91203d8e1cf599ec07bda2fca3875301 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 18:49:54 +0000
Subject: [PATCH] In the app: no "keep the display on" hints, legal links in
 the profile
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The Android app records with the display off, so the browser hints "Display
nicht ausschalten …" (free ride, ride mode) are wrong there. isApp() (user
agent "ElTouroApp/", sent by APKs from versionCode 1011) leaves them out;
older APKs get class is-app from app-pref.js (Capacitor) and .web-only is
hidden by CSS.

- footer: left out in the app for signed-in riders; signed out it stays, so
  imprint and privacy stay reachable without an account
- profile: new section "§§ Rechtliches" at the end (imprint, privacy, terms,
  feedback) – also on the web
- app-pref.js v3, style.css v81
---
 assets/app-pref.js |  2 ++
 assets/style.css   |  4 ++++
 core.php           | 20 ++++++++++++++++----
 free.php           |  4 ++--
 lang.php           |  4 ++++
 profile.php        |  9 +++++++++
 tour_go.php        |  4 ++--
 7 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/assets/app-pref.js b/assets/app-pref.js
index 4c52616..551ba90 100644
--- a/assets/app-pref.js
+++ b/assets/app-pref.js
@@ -15,4 +15,6 @@
   if (mq && mq.addEventListener) mq.addEventListener('change', applyTheme);
   window.elApplyTheme = applyTheme;
   if ((window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) || window.navigator.standalone) c.add('standalone');
+  // Inside the Android app (Capacitor injects its bridge before this script) – hides .web-only, see style.css and isApp() in core.php
+  if (window.Capacitor && typeof window.Capacitor.isNativePlatform === 'function' && window.Capacitor.isNativePlatform()) c.add('is-app');
 })();
diff --git a/assets/style.css b/assets/style.css
index d12fa25..efa2464 100644
--- a/assets/style.css
+++ b/assets/style.css
@@ -998,3 +998,7 @@ body.ae-open { overflow: hidden; }
 .warn-info { background: #EAF1F8; border-color: #B7CBE0; color: #1F4A73; }
 .ride-done-box { max-height: 88vh; overflow-y: auto; }
 .ride-done .intro-list { margin: .4rem 0; padding-left: 1.1rem; font-size: .92rem; }
+
+/* Inside the Android app: browser-only hints (keep the display on …) and the footer of signed-in riders are left out */
+.is-app .web-only { display: none !important; }
+.legal-links { display: flex; flex-wrap: wrap; gap: .4rem 1.2rem; margin: 0 0 .6rem; padding: 0; list-style: none; }
